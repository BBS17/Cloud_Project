# Copy this file to .env and fill in your values
# Never commit .env to version control

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factchecker
DB_USER=postgres
DB_PASSWORD=changeme

# CORS — comma-separated list of allowed origins.
# For local dev with the Chrome extension loading from file, set to:
#   ALLOWED_ORIGINS=http://localhost:8080
# In production, set to your actual deployed origin.
ALLOWED_ORIGINS=http://localhost:8080

# Model path inside the API container. The v2 weights are intentionally not
# committed to Git because model.safetensors is approximately 256 MB.
MODEL_PATH=/app/app/misinformation_model_v2
