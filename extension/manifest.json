{
    "manifest_version": 3,
    "name": "Fact Checker",
    "version": "1.0",
    "description": "Send selected page text to my local backend for analysis.",
    "browser_specific_settings": {
        "gecko": {
            "id": "fact-checker@local",
            "strict_min_version": "109.0"
        }
    },
    "background": {
        "scripts": ["background.js"]
    },
    "permissions": [
        "activeTab"
    ],
    "host_permissions": [
        "http://127.0.0.1:8081/*"
    ],
    "content_scripts": [
    {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
    }
  ]
}